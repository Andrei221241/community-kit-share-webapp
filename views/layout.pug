doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title #{title}

    style.
      body { font-family: Arial, sans-serif; margin: 24px; line-height: 1.4; }
      nav a { margin-right: 12px; }
      .muted { color: #666; }
      .card { border: 1px solid #ddd; border-radius: 6px; padding: 12px; margin-bottom: 12px; }
      .row { display: flex; gap: 12px; flex-wrap: wrap; }
      .badge { display: inline-block; padding: 2px 8px; border: 1px solid #999; border-radius: 12px; font-size: 12px; }
      .ok { color: #0a7a0a; }
      .warn { color: #a85d00; }
      .err { color: #b00020; }
      table { border-collapse: collapse; width: 100%; margin-top: 8px; }
      th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
      form.inline { display: inline; }

      /* NAV STYLING */
      nav { background: linear-gradient(135deg, #1e3c72, #315b2e); padding: 15px 20px; margin: -24px -24px 24px -24px; }
      nav a { color: white; text-decoration: none; margin-right: 15px; font-weight: bold; }
      nav a:hover { text-decoration: underline; }
      nav .muted { color: #ddd; }
      hr { display: none; }

      /* CARD STYLING */
      .card { border: 1px solid #ddd; border-radius: 12px; padding: 20px 25px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); transition: 0.3s; }
      .card:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.12); transform: translateY(-2px); }
      .card h3 a { color: #1e3c72; text-decoration: none; }
      .card h3 a:hover { text-decoration: underline; }

      /* BUTTON STYLING */
      button { padding: 10px 25px; background: #ff9800; color: white; border: none; border-radius: 30px; font-weight: bold; cursor: pointer; transition: 0.3s; }
      button:hover { background: #e68900; }

      /* FORM STYLING */
      input, select { padding: 8px 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 0.95rem; }

      /* HEADINGS */
      h1 { color: #1e3c72; margin-bottom: 10px; }
      h2 { color: #315b2e; margin-bottom: 10px; }

    block styles

  body
    nav
      a(href="/") Home
      a(href="/users") Users
      a(href="/listings") Listings
      a(href="/tags") Tags/Categories

      if sessionUser && sessionUser.role === 'Coordinator'
        a(href="/coordinator/requests/pending") Pending Requests

      if sessionUser && sessionUser.role === 'Member'
        a(href="/member/requests") My Requests

      if sessionUser
        span.muted  |  #{sessionUser.name} (#{sessionUser.role})
        |   
        a(href="/logout") Log out
      else
        a(href="/member/login") Log in

    hr

    block content