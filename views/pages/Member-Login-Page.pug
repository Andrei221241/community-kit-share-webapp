doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Community Member Login - Community Kit Share
    link(rel="stylesheet", href="/styles/css/Member-Login-Page.css")

  body
    main.wrap
      section.card(aria-label="Community member login")
        h1 Community Member Login
        p Enter your email and password to continue

        if error
          p.err= error

        form#memberLoginForm(action="/member/login", method="post")
          label(for="email") Email
          input#email(name="email", type="email", required)

          label(for="password") Password
          input#password(name="password", type="password", required)

          button#memberLoginBtn(type="submit") Log in

    script(src="/js/JavaScript.js")