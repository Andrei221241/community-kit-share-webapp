extends ../layout

block styles
  link(rel="stylesheet", href="/styles/css/Coordinator-Approve-Page.css")

block content
  main.wrap
    section.card
      h1 Pending Requests

      if requests && requests.length
        each req in requests
          div.card
            p
              strong Request ID: 
              | #{req.id}
            p
              strong Member: 
              | #{req.requester_name}
            p
              strong Kit: 
              | #{req.kit_name}
            p
              strong Dates: 
              | #{req.start_date} to #{req.end_date}
            p
              strong Note: 
              | #{req.note || 'None'}

            // Ensure forms are grouped safely
            div(style="display: flex; gap: 10px; margin-top: 10px;")
              form(method="POST", action=`/coordinator/requests/${req.id}/approve`)
                button(type="submit", style="background-color: #28a745;") Approve

        // Info note
        p.note
          | Review each request. Kits are 
          strong all-inclusive
          |  and matched based on location/environment + weather/temperature.

        // Requests table
        table(aria-label="Requests table")
          thead
            tr
              th Request
              th Member
              th Activity
              th Kit
              th Status
              th(style="width:220px") Actions

          tbody#requestsTableBody
            tr
              // Request ID + date
              td
                strong REQ-0001
                br
                span.note Submitted: 23 Jan 2026

              // Member
              td
                | Hamelton John
                br
                span.note ID: M-10234

              // Activity
              td
                | Outdoor activity
                br
                span.note Pickup: 25 Jan 2026

              // Kit
              td
                | Winter Kit
                br
                span.note Qty: 1

              // Status
              td
                span.status#status-REQ-0001 Pending

              // Actions
              td
                .actions
                  button.btn.btn-approve(type="button") Approve
                  button.btn.btn-reject(type="button") Reject

                div(style="margin-top:8px")
                  label.note(for="note-REQ-0001") Note (optional)
                  textarea#note-REQ-0001(
                    rows="2",
                    placeholder="Add a note for the Member…"
                  )

    script(src="/js/JavaScript.js")