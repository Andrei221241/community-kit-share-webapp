extends ../layout

block styles
  link(rel="stylesheet", href="/styles/css/Coordinator-Approve-Page.css")

block content
  main.wrap
    section.card
      // Page title
      h1 Pending Requests

      // Check if there are any requests
      if requests && requests.length

        // Loop through each request
        each req in requests
          div.card
            // Display request ID
            p
              strong Request ID: 
              | #{req.id}

            // Display member name
            p
              strong Member: 
              | #{req.requester_name}

            // Display kit name
            p
              strong Kit: 
              | #{req.kit_name}

            // Display request dates
            p
              strong Dates: 
              | #{req.start_date} to #{req.end_date}

            // Display optional note (fallback to 'None')
            p
              strong Note: 
              | #{req.note || 'None'}

            // Action buttons container
            div(style="display: flex; gap: 10px; margin-top: 10px;")

              // Approve request form
              form(method="POST", action=`/coordinator/requests/${req.id}/approve`)
                button(type="submit", style="background-color: #28a745;") Approve

              // Reject request form with optional reason
              form(method="POST", action=`/coordinator/requests/${req.id}/reject`)
                input(
                  type="text",
                  name="reason",
                  placeholder="Optional reason...",
                  style="margin-right: 10px;"
                )
                button(type="submit", style="background-color: #dc3545;") Reject
      else
        p(style="margin-bottom: 20px;") No pending requests found

        // Link back to listings page
        a(
          href="/listings",
          style="display: inline-block; padding: 10px 20px; background: #1e3c72; color: white; border-radius: 20px; text-decoration: none;"
        ) Return to Listings
