//- Extends the main layout template
extends ../layout

//- Defines additional styles specific to this page
block styles
  //- Link to coordinator approve/manage requests stylesheet
  link(rel="stylesheet", href="/styles/css/Coordinator-Approve-Page.css")

//- Defines the main content block
block content
  //- Main wrapper container
  main.wrap
    //- Card section for managing requests
    section.card
      //- Page heading
      h1 Manage Requests

      //- Check if there are any requests
      if requests && requests.length
        //- Loop through each request
        each req in requests
          //- Card container for each request
          div.card
            //- Display request ID
            p
              strong Request ID:
              |  #{req.id}

            //- Display member (requester) name
            p
              strong Member:
              |  #{req.requester_name}

            //- Display kit name
            p
              strong Kit:
              |  #{req.kit_name}

            //- Display borrowing dates
            p
              strong Dates:
              |  #{req.start_date} to #{req.end_date}

            //- Display optional note or fallback to 'None'
            p
              strong Note:
              |  #{req.note || 'None'}

            //- Display request status with appropriate badge styling
            p
              strong Status:
              if req.displayStatus === 'Currently Borrowed'
                span.badge.ok Currently Borrowed
              else if req.displayStatus === 'Overdue'
                span.badge.err Overdue by #{req.overdueDays} day#{req.overdueDays === 1 ? '' : 's'}
              else if req.displayStatus === 'Rejected'
                span.badge.err Rejected
              else if req.displayStatus === 'Returned'
                span.badge.ok Returned
              else
                span.badge.warn Pending

            //- Action buttons container (approve, reject, return)
            div(style="display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap;")
              
              //- Show approve/reject options only if request is pending
              if req.status === 'Pending'
                //- Approve request form
                form(method="POST", action=`/coordinator/requests/${req.id}/approve`)
                  button(type="submit", style="background-color: #28a745;") Approve

                //- Reject request form with optional reason input
                form(method="POST", action=`/coordinator/requests/${req.id}/reject`)
                  input(
                    type="text",
                    name="reason",
                    placeholder="Optional reason...",
                    style="margin-right: 10px;"
                  )
                  button(type="submit", style="background-color: #dc3545;") Reject

              //- Show return option if the request can be returned
              if req.canReturn
                form(method="POST", action=`/coordinator/requests/${req.id}/complete-return`)
                  button(type="submit") Return Kit for User
      else
        //- Message shown when no requests are found
        p(style="margin-bottom: 20px;") No requests found

        //- Link to return to listings page
        a(
          href="/listings",
          style="display: inline-block; padding: 10px 20px; background: #1e3c72; color: white; border-radius: 20px; text-decoration: none;"
        ) Return to Listings