//- Document type declaration
doctype html

//- Root HTML element with language set to English
html(lang="en")
  head
    //- Character encoding
    meta(charset="UTF-8")
    
    //- Responsive viewport settings
    meta(name="viewport", content="width=device-width, initial-scale=1")
    
    //- Page title
    title Create Account
    
    //- Link to external CSS stylesheet
    link(rel="stylesheet", href="/styles/css/Member-Login-Page.css")

  body
    //- Main wrapper container
    main.wrap
      //- Card section for the form UI
      section.card
        
        //- Page heading
        h1 Create Member Account

        //- Display error message if 'error' exists
        if error  
          p.error-message= error

        //- Display success message if 'success' exists
        if success
          p.success-message= success

        //- Registration form (POST request)
        form(method="POST", action="/member/register")
          
          //- Name input field
          label(for="name") Name
          input#name(type="text", name="name", required)

          //- Email input field
          label(for="email") Email
          input#email(type="email", name="email", required)

          //- Password input field
          label(for="password") Password
          input#password(type="password", name="password", required)

          //- Confirm password input field
          label(for="confirm_password") Confirm Password
          input#confirm_password(type="password", name="confirm_password", required)

          //- Submit button to create account
          button(type="submit") Create Account

        //- Form to navigate back to login page
        form(action="/member/login", method="GET")
          button(type="submit") Back to Login