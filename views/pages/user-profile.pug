extends ../layout

block content
  .card
    h1 User Profile
    p 
      strong Name: 
      | #{user.name}
    p
      strong Role: 
      | #{user.role}
    p
      strong Email: 
      | #{user.email || 'N/A'}
    if user.bio
      p
        strong Bio:
        br
        | #{user.bio}

  h2 Borrow Requests
  if requests && requests.length
    table
      thead
        tr
          th Kit Name
          th Start Date
          th End Date
          th Status
      tbody
        each req in requests
          tr
            td= req.kit_name
            td= req.start_date
            td= req.end_date
            td
              if req.status === 'Approved'
                span.badge.ok Approved
              else if req.status === 'Rejected'
                span.badge.err Rejected
              else
                span.badge.warn Pending
  else
    p This user has no borrow requests.
