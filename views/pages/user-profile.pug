extends ../layout

block content

  .card

    h1 User Profile

    p 
      strong Name: 
      | #{user.name}

    pgit
      strong Role: 
      | #{user.role}

    p
      strong Email: 
      | #{user.email || 'N/A'}

    if user.bio
      p
        strong Bio:
        br
        | #{user.bio}

    // Loyalty Points
    p
      strong Loyalty Points:
      |  #{user.loyalty_points || 0}

    // Badge
    p
      strong Badge:
      span.badge.ok #{badge}

    // Rating
    p
      strong Rating:
      |  #{averageRating || 'No ratings'} (#{totalRatings} reviews)


  // Borrow Requests
  h2 Borrow Requests

  if requests && requests.length
    table
      thead
        tr
          th Kit Name
          th Start Date
          th End Date
          th Status

      tbody
        each req in requests
          tr
            td= req.kit_name
            td= req.start_date
            td= req.end_date
            td
              if req.status === 'Approved'
                span.badge.ok Approved
              else if req.status === 'Rejected'
                span.badge.err Rejected
              else if req.status === 'Returned'
                span.badge.ok Returned
              else
                span.badge.warn Pending
  else
    p This user has no borrow requests.


  // Points
  h2 Points History

  if history && history.length
    table
      thead
        tr
          th Action
          th Points
          th Date

      tbody
        each h in history
          tr
            td= h.action_type
            td
              if h.points_change > 0
                span.badge.ok +#{h.points_change}
              else
                span.badge.err #{h.points_change}
            td= h.created_at
  else
    p No points history yet.


  // Reviews
  h2 Reviews

  if reviews && reviews.length
    each r in reviews
      .card
        p
          strong #{r.reviewer_name}
          |  – #{r.stars}/5

        if r.comment
          p= r.comment

        small #{r.created_at}
  else
    p No reviews yet.