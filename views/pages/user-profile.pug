//- Extends the main layout template
extends ../layout

//- Main content block
block content
  //- Card displaying user profile information
  .card
    //- Page title
    h1= title

    //- Display user's name
    p
      strong Name:
      |  #{user.name}

    //- Display user's role
    p
      strong Role:
      |  #{user.role}

    //- Display user's email or fallback to 'N/A'
    p
      strong Email:
      |  #{user.email || 'N/A'}

    //- Display bio only if it exists
    if user.bio
      p
        strong Bio:
        br
        | #{user.bio}

    //- Display loyalty points (default 0)
    p
      strong Loyalty Points:
      |  #{user.loyalty_points || 0}

    //- Display badge
    p
      strong Badge:
      span.badge.ok #{badge}

  //- Section for coordinators to award points (only visible in coordinator view for members)
  if isCoordinatorView && user.role === 'Member'
    .card
      h2 Award Loyalty Points

      //- Form to submit points and optional comment
      form(method="POST", action=`/coordinator/users/${user.id}/points`)
        label Points
        br
        input(type="number", name="points", min="1", max="100", required)

        br
        label Comment
        br
        input(
          type="text"
          name="comment"
          placeholder="Reason for awarding points"
          style="width: 100%; max-width: 400px;"
        )

        br
        button(type="submit", style="margin-top: 8px;") Award Points

  //- Section heading for borrow requests
  h2 Borrow Requests

  //- Check if requests exist
  if requests && requests.length
    //- Loop through each request
    each req in requests
      .card
        //- Display kit name
        p
          strong Kit:
          |  #{req.kit_name}

        //- Display borrowing dates
        p
          strong Dates:
          |  #{req.start_date} to #{req.end_date}

        //- Display request status with badges
        p
          strong Status:
          if req.displayStatus === 'Currently Borrowed'
            span.badge.ok Currently Borrowed
          else if req.displayStatus === 'Overdue'
            span.badge.err Overdue by #{req.overdueDays} day#{req.overdueDays === 1 ? '' : 's'}
          else if req.displayStatus === 'Rejected'
            span.badge.err Rejected
          else if req.displayStatus === 'Returned'
            span.badge.ok Returned
          else
            span.badge.warn Pending

        //- Show rejection reason if applicable
        if req.status === 'Rejected' && req.rejection_reason
          p
            strong Reason:
            |  #{req.rejection_reason}

        //- Show return timestamp if returned
        if req.returned_at
          p
            strong Returned At:
            |  #{req.returned_at}

        //- Show return actions depending on role
        if canManageReturns && req.canReturn
          if isCoordinatorView
            form(method="POST", action=`/coordinator/requests/${req.id}/complete-return`)
              button(type="submit") Return Kit for User
          else
            form(method="POST", action=`/member/requests/${req.id}/return`)
              button(type="submit") Return My Kit
  else
    //- Message if no requests exist
    p This user has no borrow requests.

  //- Section heading for points history
  h2 Points History

  //- Check if history exists
  if history && history.length
    table
      thead
        tr
          th Action
          th Points
          th Date
          th Comment
      tbody
        //- Loop through each history record
        each h in history
          tr
            td= h.action_type
            td
              //- Display positive or negative points with styling
              if h.points_change > 0
                span.badge.ok +#{h.points_change}
              else
                span.badge.err #{h.points_change}
            td= h.created_at
            td= h.comment || 'N/A'
  else
    //- Message if no history exists
    p No points history yet.

  //- Section heading for kit reviews
  h2 Kit Reviews

  //- Check if reviews exist
  if reviews && reviews.length
    //- Loop through each review
    each r in reviews
      .card
        //- Display kit name
        p
          strong Kit:
          |  #{r.kit_name}

        //- Display rating
        p
          strong Rating:
          |  #{r.stars}/5

        //- Display comment if it exists
        if r.comment
          p= r.comment

        //- Display creation date
        small #{r.created_at}
  else
    //- Message if no reviews exist
    p No kit reviews yet.