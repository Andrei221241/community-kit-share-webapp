//- Extends the main layout template
extends ../layout

//- Defines the content block for this page
block content
  //- Page heading
  h1 My Requests

  //- Greeting message with user's name
  p Hello, #{userName}! Here are your past and current borrow requests.

  //- Check if requests exist
  if requests && requests.length
    //- Loop through each request
    each req in requests
      //- Card container for each request
      .card
        //- Display request ID
        h3 Request ID: #{req.id}

        //- Display kit name
        p
          strong Kit:
          |  #{req.kit_name}

        //- Display borrowing dates
        p
          strong Dates:
          |  #{req.start_date} to #{req.end_date}

        //- Display request status with appropriate badge styling
        p
          strong Status:
          if req.displayStatus === 'Currently Borrowed'
            span.badge.ok Currently Borrowed
          else if req.displayStatus === 'Overdue'
            span.badge.err Overdue by #{req.overdueDays} day#{req.overdueDays === 1 ? '' : 's'}
          else if req.displayStatus === 'Rejected'
            span.badge.err Rejected
          else if req.displayStatus === 'Returned'
            span.badge.ok Returned
          else
            span.badge.warn Pending

        //- Show rejection reason if request was rejected and reason exists
        if req.status === 'Rejected' && req.rejection_reason
          p
            strong Reason:
            |  #{req.rejection_reason}

        //- Show return timestamp if the kit has been returned
        if req.returned_at
          p
            strong Returned At:
            |  #{req.returned_at}

        //- Show return button if the request can be returned
        if req.canReturn
          form(method="POST", action=`/member/requests/${req.id}/return`)
            button(type="submit") Return Kit
  else
    //- Message shown when no requests exist
    p You haven't made any borrow requests yet.

    //- Link to browse available kits
    a.btn(href="/listings") Browse Kits