extends ../layout

block content
  h1 My Requests
  p Hello, #{userName}! Here are your past and current borrow requests.

  if requests && requests.length
    each req in requests
      .card
        h3 Request ID: #{req.id}

        p
          strong Kit:
          |  #{req.kit_name}

        p
          strong Dates:
          |  #{req.start_date} to #{req.end_date}

        p
          strong Status:
          if req.displayStatus === 'Currently Borrowed'
            span.badge.ok Currently Borrowed
          else if req.displayStatus === 'Overdue'
            span.badge.err Overdue by #{req.overdueDays} day#{req.overdueDays === 1 ? '' : 's'}
          else if req.displayStatus === 'Rejected'
            span.badge.err Rejected
          else if req.displayStatus === 'Returned'
            span.badge.ok Returned
          else
            span.badge.warn Pending

        if req.status === 'Rejected' && req.rejection_reason
          p
            strong Reason:
            |  #{req.rejection_reason}

        if req.returned_at
          p
            strong Returned At:
            |  #{req.returned_at}

        a.btn(href=`/member/requests/${req.id}/messages`) View Messages

        if req.canReturn
          form(method="POST", action=`/member/requests/${req.id}/return`)
            button(type="submit") Return Kit

        if req.status === 'Returned'
          form(method="POST", action=`/member/requests/${req.id}/review`, style="margin-top: 15px;")
            label Review this kit
            br
            select(name="stars" required)
              option(value="") Select rating
              option(value="1") 1 - Poor
              option(value="2") 2 - Below Average
              option(value="3") 3 - Average
              option(value="4") 4 - Good
              option(value="5") 5 - Excellent

            br
            input(
              type="text"
              name="comment"
              placeholder="Write a short review"
              style="margin-top: 8px; width: 100%; max-width: 400px;"
            )

            br
            button(type="submit", style="margin-top: 8px;") Submit Review
  else
    p You haven't made any borrow requests yet.
    a.btn(href="/listings") Browse Kits