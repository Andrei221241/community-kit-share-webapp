extends ../layout

block styles
  link(rel="stylesheet", href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css")
  link(rel="stylesheet", href="/css/Find-Campsites-Page.css")

block content
  section.hero
    h1 Find Campsites
    p Explore suggested campsite locations across the UK.

    .buttons
      button.btn#locationBtn(type="button") Use My Location
      button.btn.secondary#nearestSearchBtn(type="button") Find Nearest
      select#activityFilter
        option(value="all") All Campsites
        option(value="tent") Camping
        option(value="hiking") Hiking
        option(value="cooking") Cooking
        option(value="family") Family

  section.videos
    h2 Campsite Map
    #map(style="height: 500px; border-radius: 12px;")

  section.about
    h2 Coordinator Suggested Campsites
    p A selection of practical and scenic UK campsites recommended for outdoor use.

    ul.place-list
      li
        strong Lake District
        |  – Hiking and scenic camping
      li
        strong Snowdonia
        |  – Mountain trips and hiking
      li
        strong New Forest
        |  – Family camping and cooking
      li
        strong Peak District
        |  – Walking and outdoor exploration
      li
        strong Cornwall
        |  – Coastal camping and family stays

  footer
    p Powered by OpenStreetMap

  script(src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js")
  script.
    document.addEventListener("DOMContentLoaded", function () {
      const map = L.map("map").setView([54.5, -3], 6);

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "&copy; OpenStreetMap contributors"
      }).addTo(map);

      const campsites = [
        { name: "Lake District", lat: 54.4609, lng: -3.0886, tags: ["tent", "hiking"] },
        { name: "Snowdonia", lat: 53.0685, lng: -4.0761, tags: ["tent", "hiking"] },
        { name: "New Forest", lat: 50.8728, lng: -1.5760, tags: ["tent", "cooking", "family"] },
        { name: "Peak District", lat: 53.3501, lng: -1.7737, tags: ["tent", "hiking"] },
        { name: "Cornwall", lat: 50.2660, lng: -5.0527, tags: ["tent", "family"] }
      ];

      let markers = [];
      let userLat = null;
      let userLng = null;
      let userMarker = null;

      function renderMarkers(filter) {
        markers.forEach(marker => map.removeLayer(marker));
        markers = [];

        campsites.forEach(site => {
          if (filter === "all" || site.tags.includes(filter)) {
            const marker = L.marker([site.lat, site.lng]).addTo(map).bindPopup(site.name);
            markers.push(marker);
          }
        });
      }

      renderMarkers("all");

      document.getElementById("activityFilter").addEventListener("change", function () {
        renderMarkers(this.value);
      });

      document.getElementById("locationBtn").addEventListener("click", function () {
        navigator.geolocation.getCurrentPosition(function (position) {
          userLat = position.coords.latitude;
          userLng = position.coords.longitude;
          map.setView([userLat, userLng], 8);

          if (userMarker) map.removeLayer(userMarker);
          userMarker = L.marker([userLat, userLng]).addTo(map).bindPopup("You are here").openPopup();
        });
      });

      document.getElementById("nearestSearchBtn").addEventListener("click", function () {
        const url = userLat && userLng
          ? `https://www.google.com/maps/search/campsites/@${userLat},${userLng},10z`
          : "https://www.google.com/maps/search/nearest+campsite+to+me";
        window.open(url, "_blank");
      });

      setTimeout(() => map.invalidateSize(), 200);
    });