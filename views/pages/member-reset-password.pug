//- Document type declaration
doctype html

//- Root HTML element with language set to English
html(lang="en")
  head
    //- Character encoding
    meta(charset="UTF-8")
    
    //- Responsive viewport settings
    meta(name="viewport", content="width=device-width, initial-scale=1")
    
    //- Page title
    title Reset Password
    
    //- Link to external CSS stylesheet
    link(rel="stylesheet", href="/styles/css/Member-Login-Page.css")

  body
    //- Main wrapper container
    main.wrap
      //- Card section for reset password form
      section.card
        
        //- Page heading
        h1 Reset Password

        //- Display error message if 'error' exists
        if error
          p.error-message= error

        //- Display success message if 'success' exists
        if success
          p.success-message= success

        //- Show reset form only if token exists
        if token
          //- Form to submit new password using token
          form(method="POST", action=`/member/reset-password/${token}`)
            
            //- New password input field
            label(for="password") New Password
            input#password(type="password", name="password", required)

            //- Confirm new password input field
            label(for="confirm_password") Confirm New Password
            input#confirm_password(type="password", name="confirm_password", required)

            //- Submit button to reset password
            button(type="submit") Reset Password

        //- Form to navigate back to login page
        form(action="/member/login", method="GET")
          button(type="submit") Back to Login