doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Request Submitted - Community Kit Share
    link(rel="stylesheet", href="/styles/css/Member-Confirmation-Page.css")

  body
    main.wrap
      section.card(aria-label="Booking submitted confirmation")
        h1 Thanks — Your request has been submitted
        p Your gear kit request has been sent to the Coordinator.

        if request
          span.status#requestStatus
            | Status: #{request.status}
          div.box
            p Kit: #{request.kit_name}
            p Start Date: #{request.start_date}
            p End Date: #{request.end_date}
            if request.note
              p Note: #{request.note}
        else
          span.status#requestStatus
            | Status: Pending approval
          div.box
            p.small
              | Please wait for approval. You will be notified once your request is approved.

        a.btn(href="/listings") Back to listings

    script(src="/js/JavaScript.js")