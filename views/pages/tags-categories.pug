extends ../layout

block content
  h1 Tags & Categories
  p.muted Browse all available tags and categories

  .row
    .card(style="flex: 1;")
      h2 Categories
      if categories.length
        ul
          each category in categories
            li
              a(href=`/listings?category=${encodeURIComponent(category.name)}`)= category.name
      else
        p No categories defined.

    .card(style="flex: 1;")
      h2 Tags
      if tags.length
        ul
          each tag in tags
            li
              a(href=`/listings?tag=${encodeURIComponent(tag.name)}`)= tag.name
      else
        p No tags defined.
