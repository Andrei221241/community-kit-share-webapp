doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Book Kit
    link(rel="stylesheet", href="/styles/css/Member-Book-Page.css")

  body
    main.wrap
      section.card
        h1 Request a Kit

        form(method="POST", action="/requests")
          label(for="missionType") Mission Type
          input#missionType(type="text", name="missionType", required)

          label(for="kitType") Kit Type
          input#kitType(type="text", name="kitType", required)

          label(for="quantity") Quantity
          input#quantity(type="number", name="quantity", min="1", value="1")

          label(for="notes") Notes
          textarea(name="notes")

          button(type="submit") Submit Request