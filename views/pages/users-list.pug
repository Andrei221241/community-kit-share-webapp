extends ../layout

block content
  h1 Users
  p.muted All community members

  if users && users.length
    table
      thead
        tr
          th Name
          th Role
          th Email
          th Actions
      tbody
        each user in users
          tr
            td= user.name
            td= user.role
            td= user.email || 'N/A'
            td
              a(href=`/users/${user.id}`) View Profile
  else
    p No users found
