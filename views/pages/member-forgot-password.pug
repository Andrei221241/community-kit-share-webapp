//- Document type declaration
doctype html

//- Root HTML element with language set to English
html(lang="en")
  head
    //- Character encoding
    meta(charset="UTF-8")

    //- Responsive viewport settings
    meta(name="viewport", content="width=device-width, initial-scale=1")

    //- Page title
    title Forgot Password

    //- Link to external CSS stylesheet
    link(rel="stylesheet", href="/styles/css/Member-Login-Page.css")

  body
    //- Main wrapper container
    main.wrap
      //- Card container for forgot password functionality
      section.card
        
        //- Page heading
        h1 Forgot Password

        //- Display error message if present
        if error
          p.error-message= error

        //- Display success message if present
        if success
          p.success-message= success

        //- Form to submit email for password reset link
        form(method="POST", action="/member/forgot-password")
          
          //- Email input field
          label(for="email") Email
          input#email(type="email", name="email", required)

          //- Submit button to send reset link
          button(type="submit") Send Reset Link

        //- If reset link exists, show button to proceed to reset password
        if resetLink
          form(action=resetLink, method="GET")
            button(type="submit") Reset Password

        //- Form to navigate back to login page
        form(action="/member/login", method="GET")
          button(type="submit") Back to Login